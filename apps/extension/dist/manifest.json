{
  "manifest_version": 3,
  "name": "Company List POC",
  "version": "0.4.0",
  "description": "Google company list extraction POC with explicit completeness checks.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "120"
}
