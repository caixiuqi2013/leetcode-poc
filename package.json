{
  "name": "leet-by-company",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate": "node --import tsx scripts/validate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "dev:web": "pnpm --filter @poc/web dev",
    "build:web": "pnpm --filter @poc/web build",
    "test:db": "node --import tsx --test tests/database.test.ts"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/chrome": "0.1.12",
    "@types/node": "24.3.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.9",
    "eslint": "^9.39.5",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.70.1"
  }
}
